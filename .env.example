# Copy these lines into your `.env` file (one per line).
# Get a free Tavily key at https://tavily.com (1,000 credits/month, no card).
# Get a free Keywords Everywhere key at https://keywordseverywhere.com, then sign in at
# https://openpagerank.keywordseverywhere.com and create an OPR API key on the Dashboard
# (30,000 domains/month free). Legacy domcop.com keys do NOT work with the current API.
# NEVER commit .env to git. NEVER paste keys into any chat window.
TAVILY_API_KEY=tvly-your-key-here
OPENPAGERANK_API_KEY=your-openpagerank-key-here
# Optional: Serper local-SERP cross-check (2,500 free searches/month at https://serper.dev).
# Leave blank = the pipeline skips step 4 silently and works without it.
SERPER_API_KEY=
